{
  "name": "sudoku-16",
  "version": "1.0.0",
  "private": true,
  "description": "16x16 Sudoku (1-9, A-G) with Easy, Medium, Hard and Extreme modes. Offline-capable PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "python3 -m http.server 4173 --directory out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:bank": "tsx scripts/generate-bank.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
